# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
# Atlas > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/vehiclepass?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# ---- CORS (comma separated, no trailing slash) ----
CLIENT_URL=http://localhost:5173

# ---- Business rules ----
DEFAULT_MAX_PARKING_MINUTES=240
TRACKING_STALE_MINUTES=5

# ---- Initial admin (used only by `npm run seed:admin`) ----
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# ---- Demo data centre point (used only by `npm run seed:demo`) ----
DEMO_CENTER_LAT=19.0760
DEMO_CENTER_LNG=72.8777
